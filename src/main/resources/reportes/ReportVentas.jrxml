				</textElement>
				<text><![CDATA[SBTO]]></text>
			</staticText>
			<staticText>
				<reportElement x="430" y="31" width="50" height="30"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[IGV]]></text>
			</staticText>
			<staticText>
				<reportElement x="480" y="31" width="50" height="30"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="35" splitType="Stretch">
			<textField>
				<reportElement x="10" y="11" width="50" height="19"/>
				<textFieldExpression><![CDATA[$F{nro_venta}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="60" y="11" width="80" height="19"/>
				<textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="11" width="60" height="19"/>
				<textFieldExpression><![CDATA[$F{id_cliente}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="200" y="11" width="76" height="19"/>
				<textFieldExpression><![CDATA[$F{razon_social}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="276" y="11" width="94" height="19"/>
				<textFieldExpression><![CDATA[$F{nombre_asesor_vta}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="370" y="11" width="60" height="19"/>
				<textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="430" y="11" width="50" height="19"/>
				<textFieldExpression><![CDATA[$F{igv}]]></textFieldExpression>
