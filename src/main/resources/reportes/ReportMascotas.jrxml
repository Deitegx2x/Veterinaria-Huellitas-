	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="veterinaria Data Adapter"/>
	<query language="SQL"><![CDATA[SELECT veterinaria.mascota.id_mascota,
	veterinaria.mascota.nombre,
	veterinaria.mascota.raza,
	veterinaria.mascota.genero,
	veterinaria.cliente.nombre,
	veterinaria.cliente.telefono
FROM veterinaria.mascota
	INNER JOIN veterinaria.cliente ON 
	 veterinaria.mascota.id_cliente = veterinaria.cliente.id_cliente]]></query>
